{
    "name": "BetterAntiAdvertisement",
    "description": "Will automatically skip and mute ads!",
    "version": "1.1",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": "iconTest.png"
    },

    "background":{
      "service_worker": "scripts/service_worker.js"
    },

  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}