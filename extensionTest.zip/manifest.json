{
    "name": "ExtensionTest",
    "description": "Here just to test extension making",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": "iconTest.png"
    },

    "background":{
      "service_worker": "scripts/service_worker.js"
    },

  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}